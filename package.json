{
  "name": "@eventonehq/migrate-mongoose",
  "version": "5.0.0",
  "description": "A mongoose based migration framework for node",
  "main": "./src/lib.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/lib.js",
      "require": "./src/lib.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "prepublish": "scripts/prepublish.sh",
    "lint": "eslint .",
    "docs": "jsdoc -c jsdoc.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "bin": {
    "migrate": "./src/cli.js"
  },
  "keywords": [
    "migrate",
    "migration",
    "mongoose",
    "schema",
    "mongodb",
    "db",
    "nosql"
  ],
  "author": "eventOne, Inc. <team@event1.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eventOneHQ/migrate-mongoose-esm.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "dotenv": "^17.4.2",
    "inquirer": "^13.4.2",
    "mkdirp": "^3.0.1",
    "mongoose": "^9.5.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^4.1.5",
    "clean-jsdoc-theme": "^4.3.2",
    "eslint": "^9.39.4",
    "globals": "^17.5.0",
    "jsdoc": "^4.0.5",
    "mongodb-memory-server": "^11.0.1",
    "prettier": "^3.8.3",
    "vitest": "^4.1.5"
  }
}